# Public source allowlist. Local operational records stay untracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/requirements-dev.txt
!/package.json
!/package-lock.json
!/Install-AnimeService.ps1
!/Start-AnimeService.ps1
!/Stop-AnimeService.ps1
!/Remove-Autostart.ps1
!/Open-AnimeService.cmd
!/anime/
!/static/
!/tests/
!/integrations/
!/scripts/
!/docs/
!/.github/
/scripts/*
!/scripts/setup_web.py
!/scripts/patch_danmu_proxy.py
!/scripts/Read-DandanHistory.ps1
!/scripts/supervisor.py
!/scripts/stop_danmu.py
!/scripts/stop_https.py
/docs/*
!/docs/DEVELOPMENT.md
!/docs/deployment.example.json
/static/vendor/
**/__pycache__/
**/node_modules/
**/.pytest_cache/
**/*.pyc
**/*.db
**/*.db-*
**/*.sqlite*
**/.env
**/*.pem
**/*.key
**/*.pfx
**/*.torrent
**/*.log
**/*credential*
