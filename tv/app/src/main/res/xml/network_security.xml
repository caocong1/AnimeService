<?xml version="1.0" encoding="utf-8"?>
<!-- LAN servers are plain HTTP. Remote servers use HTTPS; Let's Encrypt roots are bundled
     because boxes on Android 7.0 and older do not trust ISRG Root X1. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
